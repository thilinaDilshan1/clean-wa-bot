# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Command prefix, e.g. "!" or "."
PREFIX=!

# Your own WhatsApp number in international format, no + or spaces, e.g. 947XXXXXXXX
# Used for owner-only command checks.
OWNER_NUMBER=

# Optional: bot display name used in menu/alive replies
BOT_NAME=CleanBot
